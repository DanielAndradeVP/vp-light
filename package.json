{
  "name": "vp-light",
  "version": "1.0.0",
  "description": "Software DMX para Igreja Vida e Paz",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:linux": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && electron . --disable-gpu\"",
    "build": "vite build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "build": {
    "appId": "br.vidaepaz.vplight",
    "productName": "vp-light",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "shows/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
